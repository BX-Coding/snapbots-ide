{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/modal/session/by-slug/:slug",
      "destination": "/api/modal/session/by-slug?slug=:slug"
    },
    {
      "source": "/api/modal/session/:id/command/:cmdId/ack",
      "destination": "/api/modal/session/ack?id=:id&cmdId=:cmdId"
    },
    {
      "source": "/api/modal/session/:id/command",
      "destination": "/api/modal/session/command?id=:id"
    },
    {
      "source": "/api/modal/session/:id/submission/:subId",
      "destination": "/api/modal/session/submission?id=:id&subId=:subId"
    },
    {
      "source": "/api/modal/session/:id/submit",
      "destination": "/api/modal/session/submit?id=:id"
    },
    {
      "source": "/api/modal/session/:id/end",
      "destination": "/api/modal/session/end?id=:id"
    },
    {
      "source": "/api/modal/session/:id",
      "destination": "/api/modal/session/get?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "ENVIRONMENT": "production"
  }
}
